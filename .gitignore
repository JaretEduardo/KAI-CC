*.tmp
*.log

# Python bytecode cache (e.g. from benchmarks/ai-native/v1/scripts/*.py
# and scripts/isolation/*.py being imported/compiled locally)
__pycache__/
*.pyc

# AI-native benchmark trial work directories (generated by prepare-run.sh;
# reproducible from benchmarks/ai-native/v1/baseline + scripts, never
# hand-authored)
benchmarks/ai-native/v1/runs/*
!benchmarks/ai-native/v1/runs/.gitkeep