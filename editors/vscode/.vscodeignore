# Controls what @vscode/vsce packages into the .vsix - INDEPENDENT of
# .gitignore (vsce is known to also consult .gitignore by default, which
# would otherwise accidentally exclude the staged bin/lib artifacts below -
# the explicit "!" negations make sure those ship regardless).

# TypeScript source - only the compiled out/*.js is needed at runtime.
src/**
tsconfig.json
*.tsbuildinfo

# Dev-only packaging/test scripts and their own tests - not used by the
# installed extension itself.
scripts/**
out/test/**

# npm tooling/metadata not needed inside the installed extension.
node_modules/**
package-lock.json
.gitignore
.vscodeignore

# Source maps (debugging convenience only - keep the package lean).
out/**/*.map

# Master SVG source for assets/icon.png (VS Code MILESTONE 4) - only the
# rasterized PNG is actually referenced (package.json's "icon" field
# requires PNG, not SVG); the SVG is design source, kept in git for
# regeneration but not needed inside the installed extension.
assets/icon.svg

# Never exclude the staged native compiler/runtime - these MUST ship
# despite being .gitignore'd (they are build artifacts, not source).
!bin/**
!lib/**

# v0.1.0-alpha.1: never exclude the staged legal material either (project
# LICENSE, THIRD_PARTY_NOTICES.md, third-party license texts) - it too is
# .gitignore'd here (staged, not hand-authored in this directory) but must
# ship in the VSIX, since the bundled kaicc/LLVM/Z3 binary content requires it.
!LICENSE
!THIRD_PARTY_NOTICES.md
!third_party/**
