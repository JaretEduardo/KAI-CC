// KAI LANGUAGE M8B: a fixed-size array parameter and return, passed an
// EXISTING array value by value - `numbers` is untouched by the call
// (arrays are value types, no aliasing - see TYPE_SYSTEM.md).
fn sum(xs: [i32; 4]) -> i32 {
    mut total = 0
    for i in 0..4 {
        total = total + xs[i]
    }
    return total
}

fn main() {
    let numbers = [10, 20, 30, 40]

    print(numbers[0])
    print(numbers[3])
    print(sum(numbers))

    for i in 0..4 {
        print(numbers[i])
    }

    mut counters = [0, 0, 0]

    for i in 0..3 {
        counters[i] = counters[i] + 1
    }

    for i in 0..3 {
        print(counters[i])
    }

    // KAI LANGUAGE M9: nested fixed-array indexing - `matrix` is a
    // `[[i32; 2]; 2]` (an array of arrays), and `matrix[row][col]`
    // recursively checks bounds at EACH level before reading or writing.
    mut matrix = [[1, 2], [3, 4]]

    print(matrix[0][1])

    matrix[1][0] = 99
    print(matrix[1][0])
}
